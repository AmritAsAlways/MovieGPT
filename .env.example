# Copy this file to ".env" and fill in your own values.
# Restart `npm start` after changing it.

# Section 4: TMDB "API Read Access Token" (the long Bearer token), from
# https://www.themoviedb.org/settings/api
REACT_APP_TMDB_KEY=

# Section 6: OpenAI API key, from https://platform.openai.com/api-keys
REACT_APP_OPENAI_KEY=

# Section 6 (optional): which OpenAI model to use. Leave empty for the default
# (gpt-6-luna). Set it if your account can't use the default model.
REACT_APP_OPENAI_MODEL=

# Section 3: Firebase web app config, from Firebase console > Project settings
